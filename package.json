{
  "name": "magical-hamster",
  "private": true,
  "version": "0.1.4",
  "description": "Meeting assistant for Obsidian: live transcript, enhanced notes, summaries and Q&A, all on-device.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/baconbro/magical-hamster"
  },
  "engines": {
    "node": ">=22.18"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.dev.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "build": "pnpm typecheck && vite build && node scripts/plugin-manifest.mjs && node scripts/build-setup.mjs",
    "install:plugin": "HAMSTER_DEV_BUILD=1 pnpm build && node scripts/install-plugin.mjs",
    "setup:stt": "node scripts/setup-stt.mjs",
    "bench:llm": "node scripts/bench-llm.mjs",
    "bench:stt": "node scripts/bench-stt.mjs",
    "dev:vault": "node scripts/dev-vault.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.2.1",
    "obsidian": "1.14.4",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "packageManager": "pnpm@12.3.4"
}
